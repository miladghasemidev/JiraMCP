{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/tool-result.schema.json",
  "title": "Tool Result Envelope",
  "oneOf": [
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["status", "capability_id", "contract_version", "trace_id", "collected_at"],
      "properties": {
        "status": { "enum": ["succeeded", "partial", "failed"] },
        "capability_id": { "type": "string" },
        "contract_version": { "type": "string" },
        "trace_id": { "type": "string", "minLength": 1 },
        "collected_at": { "type": "string", "format": "date-time" }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": { "enum": ["complete", "paginated", "filtered", "sampled", "truncated"] },
        "record_count": { "type": "integer", "minimum": 0 },
        "total_count": { "type": ["integer", "null"], "minimum": 0 },
        "byte_count": { "type": "integer", "minimum": 0 },
        "next_cursor": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "result_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expires_at"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "format": "date-time" },
        "schema_version": { "type": ["string", "null"] }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "stage"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "stage": { "type": "string" },
        "remediation_hint": { "type": ["string", "null"] },
        "details_ref": { "type": ["string", "null"] }
      }
    },
    "success": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "capability_id", "contract_version", "trace_id", "collected_at", "completeness"],
          "properties": {
            "status": { "enum": ["succeeded", "partial"] },
            "capability_id": { "type": "string" },
            "contract_version": { "type": "string" },
            "trace_id": { "type": "string" },
            "collected_at": { "type": "string", "format": "date-time" },
            "data": {},
            "result_ref": { "anyOf": [{ "$ref": "#/$defs/result_ref" }, { "type": "null" }] },
            "completeness": { "$ref": "#/$defs/completeness" },
            "provenance": { "type": "array", "items": { "type": "object" } },
            "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } },
            "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }
          }
        }
      ]
    },
    "failure": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "capability_id", "contract_version", "trace_id", "collected_at", "error"],
          "properties": {
            "status": { "const": "failed" },
            "capability_id": { "type": "string" },
            "contract_version": { "type": "string" },
            "trace_id": { "type": "string" },
            "collected_at": { "type": "string", "format": "date-time" },
            "error": { "$ref": "#/$defs/error" }
          }
        }
      ]
    }
  }
}


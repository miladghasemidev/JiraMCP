{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/eval-case.schema.json",
  "title": "Agent Evaluation Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "version",
    "category",
    "risk_class",
    "input",
    "authorization",
    "capabilities",
    "expected",
    "hard_fail_conditions",
    "budgets"
  ],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "category": { "enum": ["easy", "normal", "difficult", "adversarial", "permission_safety"] },
    "risk_class": { "enum": ["R0", "R1", "R2", "W1", "W2", "W3"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "input": {
      "type": "object",
      "required": ["conversation"],
      "properties": {
        "conversation": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "environment_fixture": { "type": "object" },
        "backend_fixtures": { "type": "array", "items": { "type": "object" } }
      }
    },
    "authorization": {
      "type": "object",
      "required": ["user_permissions", "approval_state"],
      "properties": {
        "user_permissions": { "type": "array", "items": { "type": "string" } },
        "approval_state": { "type": "object" }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["available", "forbidden"],
      "properties": {
        "available": { "type": "array", "items": { "type": "string" } },
        "forbidden": { "type": "array", "items": { "type": "string" } }
      }
    },
    "expected": {
      "type": "object",
      "required": ["selection", "required_evidence", "output_assertions", "forbidden_behavior"],
      "properties": {
        "selection": { "type": "object" },
        "required_calls": { "type": "array", "items": { "type": "object" } },
        "required_evidence": { "type": "array", "items": { "type": "string" } },
        "output_assertions": { "type": "array", "items": { "type": "object" } },
        "forbidden_behavior": { "type": "array", "items": { "type": "string" } },
        "allowed_variation": { "type": "array", "items": { "type": "string" } }
      }
    },
    "hard_fail_conditions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "budgets": {
      "type": "object",
      "required": ["max_tool_calls", "max_total_seconds"],
      "properties": {
        "max_tool_calls": { "type": "integer", "minimum": 0 },
        "max_total_seconds": { "type": "integer", "minimum": 1 },
        "max_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "max_output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "max_cost": { "type": ["number", "null"], "minimum": 0 }
      }
    }
  }
}


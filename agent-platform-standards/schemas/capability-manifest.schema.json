{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/capability-manifest.schema.json",
  "title": "Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_id",
    "registry_component_id",
    "version",
    "artifact_type",
    "title",
    "description",
    "domains",
    "positive_cues",
    "negative_cues",
    "risk_class",
    "permissions",
    "supported_targets",
    "limits",
    "owner",
    "status",
    "definition_locator"
  ],
  "properties": {
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
    },
    "registry_component_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "artifact_type": {
      "enum": ["tool", "resource", "skill", "cli", "code", "result_operation"]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 20, "maxLength": 800 },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "intents": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "positive_cues": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "negative_cues": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "risk_class": { "enum": ["R0", "R1", "R2", "W1", "W2", "W3"] },
    "side_effects": {
      "type": "array",
      "items": { "type": "string", "maxLength": 300 }
    },
    "permissions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "approval_class": { "type": ["string", "null"], "maxLength": 100 },
    "supported_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["product", "versions", "environments"],
        "properties": {
          "product": { "type": "string", "minLength": 1 },
          "versions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "environments": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "limitations": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "input_summary": { "type": "string", "maxLength": 500 },
    "output_summary": { "type": "string", "maxLength": 500 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_seconds", "max_inline_bytes"],
      "properties": {
        "max_seconds": { "type": "integer", "minimum": 1 },
        "max_inline_bytes": { "type": "integer", "minimum": 0 },
        "max_records": { "type": ["integer", "null"], "minimum": 0 },
        "max_calls": { "type": ["integer", "null"], "minimum": 0 },
        "cost_class": { "enum": ["low", "medium", "high"] },
        "latency_class": { "enum": ["interactive", "long_running", "asynchronous"] }
      }
    },
    "owner": { "type": "string", "minLength": 1, "maxLength": 160 },
    "status": { "enum": ["draft", "active", "deprecated", "disabled"] },
    "definition_locator": { "type": "string", "minLength": 1 },
    "deprecated_by": { "type": ["string", "null"] },
    "review_date": { "type": ["string", "null"], "format": "date" },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  }
}

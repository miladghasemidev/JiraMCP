{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/audit-event.schema.json",
  "title": "Agent Platform Audit Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "trace_id",
    "actor",
    "action",
    "target",
    "decision",
    "environment"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "event_type": {
      "enum": [
        "authorization_decision",
        "approval_created",
        "approval_consumed",
        "capability_invoked",
        "mutation_completed",
        "sensitive_read",
        "result_exported",
        "policy_changed",
        "break_glass_used",
        "capability_disabled"
      ]
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string", "minLength": 1 },
    "span_id": { "type": ["string", "null"] },
    "tenant_id": { "type": ["string", "null"] },
    "environment": { "type": "string", "minLength": 1 },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_type", "actor_id"],
      "properties": {
        "actor_type": { "enum": ["user", "agent", "workload", "administrator"] },
        "actor_id": { "type": "string", "minLength": 1 },
        "delegated_user_id": { "type": ["string", "null"] }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "contract_version", "risk_class"],
      "properties": {
        "capability_id": { "type": "string" },
        "contract_version": { "type": "string" },
        "risk_class": { "enum": ["R0", "R1", "R2", "W1", "W2", "W3"] },
        "action_digest": { "type": ["string", "null"] }
      }
    },
    "target": { "type": "object" },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["allowed", "denied", "completed", "partial", "failed", "unknown"] },
        "policy_version": { "type": ["string", "null"] },
        "approval_id": { "type": ["string", "null"] },
        "reason_code": { "type": ["string", "null"] }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_ms": { "type": "integer", "minimum": 0 },
        "record_count": { "type": "integer", "minimum": 0 },
        "request_bytes": { "type": "integer", "minimum": 0 },
        "response_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "result_ref": { "type": ["string", "null"] },
    "redactions_applied": { "type": "array", "items": { "type": "string" } },
    "previous_event_hash": { "type": ["string", "null"] },
    "event_hash": { "type": ["string", "null"] }
  }
}


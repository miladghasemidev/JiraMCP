{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/agent-registry.schema.json",
  "title": "Agent Platform Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "generated_at", "components", "relationships"],
  "properties": {
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "components": {
      "type": "array",
      "items": { "$ref": "#/$defs/component" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "description",
        "version",
        "owner",
        "status",
        "risk_class",
        "environments",
        "source_ref",
        "policy_refs",
        "created_at",
        "updated_at",
        "review_date"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
        },
        "kind": {
          "enum": [
            "agent",
            "mcp_server",
            "tool",
            "skill",
            "model",
            "runtime",
            "cli",
            "gateway",
            "endpoint",
            "backend",
            "knowledge_source",
            "result_store",
            "policy",
            "evaluation_suite"
          ]
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "description": { "type": "string", "minLength": 10, "maxLength": 1000 },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["team"],
          "properties": {
            "team": { "type": "string", "minLength": 1 },
            "technical_contact": { "type": ["string", "null"] },
            "backup_team": { "type": ["string", "null"] }
          }
        },
        "status": {
          "enum": ["draft", "review", "approved", "active", "deprecated", "disabled", "retired", "unmanaged"]
        },
        "risk_class": { "enum": ["R0", "R1", "R2", "W1", "W2", "W3"] },
        "data_classifications": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "deployments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["deployment_id", "environment", "status"],
            "properties": {
              "deployment_id": { "type": "string", "minLength": 1 },
              "environment": { "type": "string", "minLength": 1 },
              "endpoint_ref": { "type": ["string", "null"] },
              "region_or_zone": { "type": ["string", "null"] },
              "status": { "enum": ["planned", "active", "degraded", "disabled", "retired"] }
            }
          }
        },
        "source_ref": { "type": "string", "minLength": 1 },
        "artifact_digest": { "type": ["string", "null"] },
        "manifest_ref": { "type": ["string", "null"] },
        "policy_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evaluation_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "observability_refs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "permissions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metadata": {
          "type": "object"
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "last_verified_at": { "type": ["string", "null"], "format": "date-time" },
        "review_date": { "type": "string", "format": "date" },
        "deprecated_by": { "type": ["string", "null"] },
        "rollback_ref": { "type": ["string", "null"] }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "relationship_type",
        "target_id",
        "environment",
        "required",
        "origin",
        "status"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "relationship_type": {
          "enum": [
            "uses",
            "requires",
            "provides",
            "invokes",
            "routes_through",
            "connects_to",
            "reads_from",
            "writes_to",
            "runs_on",
            "governed_by",
            "evaluated_by",
            "depends_on",
            "replaces"
          ]
        },
        "target_id": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "target_scope": { "type": ["object", "null"] },
        "required": { "type": "boolean" },
        "origin": { "enum": ["declared", "observed", "both"] },
        "status": { "enum": ["active", "stale", "unexpected", "disabled"] },
        "version_constraint": { "type": ["string", "null"] },
        "access_mode": { "enum": ["none", "read", "write", "admin", "mixed"] },
        "data_classifications": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence_ref": { "type": ["string", "null"] },
        "first_observed_at": { "type": ["string", "null"], "format": "date-time" },
        "last_observed_at": { "type": ["string", "null"], "format": "date-time" },
        "observation_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}

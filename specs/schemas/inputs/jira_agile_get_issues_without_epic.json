    "target_id",
    "trace_id"
  ],
  "properties": {
    "environment": {
      "type": "string",
      "enum": [
        "development",
        "test",
        "production"
      ]
    },
    "target_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "start_at": {
      "type": "integer",
      "minimum": 0
    },
    "max_results": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 50
    },
    "jql": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "validate_query": {
      "type": "boolean"
    },
    "fields": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "expand": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}

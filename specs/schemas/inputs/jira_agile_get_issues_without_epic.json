{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jira-mcp.invalid/schemas/input/jira_agile_get_issues_without_epic.1.0.0.json",
  "title": "Input for jira_agile_get_issues_without_epic",
  "type": "object",
  "additionalProperties": false,
  "required": [

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jira-mcp.invalid/schemas/input/jira_version_get_remote_version_links.1.0.0.json",
  "title": "Input for jira_version_get_remote_version_links",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environment",
    "target_id",
    "trace_id"
  ],
  "properties": {
    "environment": {
      "type": "string",
      "enum": [
        "development",
        "test",
        "production"
      ]
    },
    "target_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "global_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}

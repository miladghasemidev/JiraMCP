{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jira-mcp.invalid/schemas/input/jira_issue_add_attachment.1.0.0.json",
  "title": "Input for jira_issue_add_attachment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environment",
    "target_id",
    "trace_id",
    "issue_id_or_key",
    "idempotency_key",
    "attachments",
    "approval_ref"
  ],
  "properties": {
    "environment": {
      "type": "string",
      "enum": [
        "development",
        "test",
        "production"
      ]
    },
    "target_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "issue_id_or_key": {
      "type": [
        "string",
        "integer"
      ],
      "minLength": 1,
      "maxLength": 255
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "precondition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "attachments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "filename",
          "content_base64",
          "media_type"
        ],
        "properties": {
          "filename": {
            "type": "string",
            "pattern": "^[^/\\\\\\x00-\\x1f]{1,255}$"
          },
          "content_base64": {
            "type": "string",
            "minLength": 4,
            "maxLength": 8388608
          },
          "media_type": {
            "type": "string",
            "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$",
            "maxLength": 127
          }
        }
      }
    },
    "approval_ref": {
      "type": "string",
      "pattern": "^approval:[A-Za-z0-9._:-]{8,128}$"
    }
  }
}

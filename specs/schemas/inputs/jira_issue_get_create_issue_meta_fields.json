{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jira-mcp.invalid/schemas/input/jira_issue_get_create_issue_meta_fields.1.0.0.json",
  "title": "Input for jira_issue_get_create_issue_meta_fields",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environment",
    "target_id",
    "trace_id",
    "project_id_or_key",
    "issue_type_id"
  ],
  "properties": {
    "environment": {
      "type": "string",
      "enum": [
        "development",
        "test",
        "production"
      ]
    },
    "target_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{8,128}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "project_id_or_key": {
      "type": [
        "string",
        "integer"
      ],
      "minLength": 1,
      "maxLength": 255
    },
    "issue_type_id": {
      "type": [
        "string",
        "integer"
      ],
      "minLength": 1,
      "maxLength": 255
    },
    "start_at": {
      "type": "integer",
      "minimum": 0
    },
    "max_results": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 50
    }
  }
}
